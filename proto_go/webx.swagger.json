          }
        }
      }
    },
    "v1LoginRequest": {
      "type": "object",
      "properties": {
        "address": {
          "type": "string",
          "title": "EVM wallet address (must match the signed nonce)"
        },
        "signature": {
          "type": "string",
          "title": "EIP-191 personal_sign signature (hex, 65 bytes)"
        }
      }
    },
    "v1LoginResponse": {
      "type": "object",
      "properties": {
        "token": {
          "type": "string"
        },
        "expires_at": {
          "type": "string",
          "format": "int64",
          "description": "Unix seconds."
        },
        "user": {
          "$ref": "#/definitions/v1User"
        },
        "is_new": {
          "type": "boolean",
          "title": "true when the account was created by this login"
        }
      }
    },
    "v1LogoutRequest": {
      "type": "object"
    },
    "v1LogoutResponse": {
      "type": "object"
    },
    "v1MenuItem": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "int64"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "price_cents": {
          "type": "string",
          "format": "int64",
          "description": "price_cents is the unit price in the smallest currency unit (e.g. cents),\nstored as an integer to avoid floating-point rounding."
        },
        "available": {
          "type": "boolean",
          "description": "available reports whether the item can currently be ordered."
        },
        "created_at": {
          "type": "string",
          "format": "int64",
          "description": "Unix seconds."
        },
        "updated_at": {
          "type": "string",
          "format": "int64",
          "description": "Unix seconds."
        }
      },
      "description": "MenuItem is a single sellable product on the bar menu."
    },
    "v1Order": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "int64"
        },
        "table_no": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/v1OrderStatus"
        },
        "total_cents": {
          "type": "string",
          "format": "int64"
        },
        "note": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1OrderItem"
          }
        },
        "created_at": {
          "type": "string",
          "format": "int64",
          "description": "Unix seconds."
        },
        "updated_at": {
          "type": "string",
          "format": "int64",
          "description": "Unix seconds."
        }
      },
      "description": "Order is a customer's order placed from a table."
    },
    "v1OrderItem": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "int64"
        },
        "order_id": {
          "type": "string",
          "format": "int64"
        },
        "menu_item_id": {
          "type": "string",
          "format": "int64"
        },
        "name": {
          "type": "string",
          "title": "snapshot of the menu item name"
        },
        "unit_price_cents": {
          "type": "string",
          "format": "int64",
          "title": "snapshot of the unit price"
        },
        "quantity": {
          "type": "integer",
          "format": "int32"
        },
        "subtotal_cents": {
          "type": "string",
          "format": "int64",
          "title": "unit_price_cents * quantity"
        }
      },
      "description": "OrderItem is a single line of an order. name and unit_price_cents are\nsnapshots taken from the catalog at creation time so later menu edits do not\nchange historical orders."
    },
    "v1OrderStatus": {
      "type": "string",
      "enum": [
        "ORDER_STATUS_UNSPECIFIED",
        "ORDER_STATUS_PENDING",
        "ORDER_STATUS_PAID",
        "ORDER_STATUS_PREPARING",
        "ORDER_STATUS_SERVED",
        "ORDER_STATUS_CANCELLED"
      ],
      "default": "ORDER_STATUS_UNSPECIFIED",
      "description": "OrderStatus is the lifecycle state of an order.\n\n - ORDER_STATUS_PENDING: created, awaiting payment\n - ORDER_STATUS_PAID: paid, queued for the kitchen/bar\n - ORDER_STATUS_PREPARING: being prepared (KDS)\n - ORDER_STATUS_SERVED: delivered to the table\n - ORDER_STATUS_CANCELLED: cancelled"
    },
    "v1Permission": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "int64"
        },
        "resource": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "description": "Permission is a single resource+action capability."
    },
    "v1Role": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "int64"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Permission"
          }
        }
      },
      "description": "Role is a named collection of permissions assignable to users."
    },
    "v1UpdateItemResponse": {
      "type": "object",
      "properties": {
        "item": {
          "$ref": "#/definitions/v1MenuItem"
        }
      }
    },
    "v1UpdateOrderStatusResponse": {
      "type": "object",
      "properties": {
        "order": {
          "$ref": "#/definitions/v1Order"
        }
      }
    },
    "v1User": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "int64"
        },
        "address": {
          "type": "string",
          "title": "lowercase EVM wallet address (0x…)"
        },
        "nickname": {
          "type": "string"
        },
        "avatar_url": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Role"
          }
        },
        "created_at": {
          "type": "string",
          "format": "int64",
          "description": "Unix seconds."
        },
        "updated_at": {
          "type": "string",
          "format": "int64",
          "description": "Unix seconds."
        }
      },
      "description": "User is the public projection of an account."
    }
  }
}
