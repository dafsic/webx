            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "format": "int64"
          }
        ],
        "tags": [
          "orders"
        ]
      }
    },
    "/api/v1/orders/{id}/status": {
      "patch": {
        "summary": "更新订单状态",
