        }
      }
    },
    "v1CreateOrderLine": {
      "type": "object",
      "properties": {
        "menu_item_id": {
          "type": "string",
          "format": "int64"
        },
        "quantity": {
          "type": "integer",
          "format": "int32"
        }
      },
      "description": "CreateOrderLine is a requested line: a menu item id and a quantity. The\nserver resolves the name and price from the catalog service."
    },
    "v1CreateOrderRequest": {
      "type": "object",
      "properties": {
        "table_no": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
