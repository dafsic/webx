# 复制为 .env 后按需修改；docker compose 会自动读取。
# 不设置时，docker-compose.yml 内已内置可直接启动的开发默认值。

# people 签发 / gateway 校验共享的 HS256 密钥（生产环境务必修改为强随机值）
JWT_SECRET=dev-secret-change-me

# PostgreSQL 密码（默认 webx）
POSTGRES_PASSWORD=webx

# 日志级别：debug | info | warn | error
LOG_LEVEL=info

# 允许的跨域来源，多个用逗号分隔，* 表示任意
CORS_ORIGINS=*
